# Local SQLite database. The parent data/ directory is created automatically.
DATABASE_URL=sqlite:///data/uci.db

# Directory for per-run model bundles, metrics, predictions, and reports.
ARTIFACT_DIR=artifacts

# Optional PostgreSQL settings used by compose.yaml.
# Start PostgreSQL with `docker compose up -d --wait`, then set DATABASE_URL to:
# postgresql+psycopg://clv:clv_local@localhost:55432/clv
POSTGRES_USER=clv
POSTGRES_PASSWORD=clv_local
POSTGRES_DB=clv

# Reserved for future integrations. S3 uploads and scheduled training are not implemented.
S3_ENDPOINT_URL=
S3_BUCKET=
SCHEDULER_ENABLED=false
